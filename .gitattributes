# Normalize text files to LF in the repo and working tree.
# Overrides any local core.autocrlf so line endings stay LF.
* text=auto eol=lf

# Windows batch wrappers are stored and checked out with CRLF, byte for byte.
# Without conversion, a wrapper update from Dependabot (which writes CRLF)
# does not flip the stored line endings.
*.bat -text
*.cmd -text
